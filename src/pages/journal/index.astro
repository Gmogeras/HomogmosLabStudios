---
import Base from '../../layouts/Base.astro';
import { stories } from '../../data/stories';
---
<Base title="Journal — HomogmosLab Studios">
  <section class="page-intro">
    <div>
      <p class="eyebrow">JOURNAL / WRITTEN WORK</p>
      <h1>
        Essays, notes<br />
        and <em>arguments.</em>
      </h1>
      <p>
        El Journal es la mesa editorial del estudio: donde se incuban ensayos largos, editoriales, notas de método y piezas escritas nacidas de la misma
        investigación madre.
      </p>
    </div>
  </section>

  <section class="section journal-showcase">
    <div class="journal-card-large">
      <span class="eyebrow">EDITORIAL PHILOSOPHY</span>
      <h2>Writing is not an afterthought here. It is usually the first complete version of the story.</h2>
      <p>
        El texto largo organiza la evidencia y afina la voz. Después vendrán otros formatos, pero rara vez sustituyen el valor del escrito maestro.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="journal-list">
      {stories.map((story, index) => (
        <a href={`/stories/${story.slug}`} class="journal-entry">
          <span>0{index + 1}</span>
          <div>
            <p class="eyebrow">{story.category}</p>
            <h3>{story.title}</h3>
          </div>
          <small>Open story file ↗</small>
        </a>
      ))}
    </div>
  </section>
</Base>
