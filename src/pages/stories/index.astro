---
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import { stories } from '../../data/stories';
---
<Base title="Stories — HomogmosLab Studios">
  <section class="page-intro page-intro-archive">
    <div>
      <p class="eyebrow">ARCHIVE / STORIES</p>
      <h1>
        An archive of<br />
        <em>unfinished curiosity.</em>
      </h1>
      <p>
        Cada historia es un centro de gravedad. Desde ahí pueden aparecer ensayos, piezas de audio, materiales visuales y futuras adaptaciones,
        siempre conectadas al mismo expediente.
      </p>
    </div>
    <div class="intro-sidecard">
      <span>EDITORIAL RULE</span>
      <strong>Stories first.</strong>
      <p>No pensamos en plataformas aisladas. Pensamos en preguntas que merecen distintas formas de existir.</p>
    </div>
  </section>

  <section class="section archive-filters">
    <div class="tag-row wide">
      <span>Evolution</span>
      <span>Genomics</span>
      <span>Extinction</span>
      <span>Natural history</span>
      <span>Human origins</span>
      <span>Science stories</span>
    </div>
  </section>

  <section class="section archive-grid-section">
    <div class="archive-grid three-col">
      {stories.map((story) => (
        <StoryCard story={story} />
      ))}
    </div>
  </section>
</Base>
