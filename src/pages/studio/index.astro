---
import Base from '../../layouts/Base.astro';
---
<Base title="Studio — HomogmosLab Studios">
  <section class="page-intro">
    <div>
      <p class="eyebrow">THE STUDIO / ABOUT</p>
      <h1>
        Built from questions.<br />
        Led by <em>curiosity.</em>
      </h1>
      <p>Un estudio independiente de ciencia, escritura y narrativa visual.</p>
    </div>
  </section>

  <section class="studio-columns story-grid-panel">
    <div>
      <p class="section-kicker">PHILOSOPHY</p>
      <h2>We investigate first. Then we choose the format.</h2>
    </div>
    <div>
      <p class="lead-text">El proyecto nace de la biología evolutiva, la genómica y el análisis científico.</p>
      <p>Ese fondo se transforma en historias, guiones y clases.</p>
    </div>
  </section>

  <section class="section services-panel">
    <div class="section-head stacked">
      <p class="eyebrow">WHAT THE STUDIO CAN DO</p>
      <h2>Ways to collaborate.</h2>
    </div>

    <div class="services-grid">
      <article>
        <span>01</span>
        <h3>Scientific storytelling</h3>
        <p>Historias científicas y editoriales.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Documentary research</h3>
        <p>Fuentes, soporte científico y estructura.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Education & workshops</h3>
        <p>Talleres y experiencias de aprendizaje.</p>
      </article>
      <article>
        <span>04</span>
        <h3>Editorial collaborations</h3>
        <p>Colaboraciones con medios e instituciones.</p>
      </article>
    </div>
  </section>
</Base>
