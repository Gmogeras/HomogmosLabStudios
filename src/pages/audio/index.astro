---
import Base from '../../layouts/Base.astro';
import { stories } from '../../data/stories';
---
<Base title="Audio — HomogmosLab Studios">
  <section class="page-intro">
    <div>
      <p class="eyebrow">AUDIO / NARRATIVE SCIENCE</p>
      <h1>
        Research that can also<br />
        be <em>heard.</em>
      </h1>
      <p>Audio para convertir investigación en escucha.</p>
    </div>
  </section>

  <section class="section media-grid">
    <article class="media-feature audio">
      <div class="media-icon">◉</div>
      <div>
        <p class="eyebrow">PODCAST CONCEPT / FILE 001</p>
        <h2>{stories[0].title}</h2>
        <p>Un episodio futuro basado en el escrito maestro.</p>
        <a href={`/stories/${stories[0].slug}`} class="button-ghost">Open story file</a>
      </div>
    </article>
  </section>
</Base>
