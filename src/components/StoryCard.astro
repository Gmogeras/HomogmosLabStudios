---
import type { Story } from '../data/stories';
const { story, featured = false } = Astro.props as { story: Story; featured?: boolean };
---
<a href={`/stories/${story.slug}`} class:list={['story-card', { featured }]}>
  <div class:list={['story-art', story.art]} aria-hidden="true">
    <span class="art-meta">FILE {story.number}</span>
    <span class="art-cross">✳</span>
    <div class="art-overlay-copy">
      <span>{story.category}</span>
      <strong>{story.logline}</strong>
    </div>
  </div>

  <div class="story-info">
    <div class="micro split">
      <span>{story.category}</span>
      <span>{story.status === 'concepto' ? 'IN DEVELOPMENT' : 'PUBLISHED'}</span>
    </div>
    <h3>{story.title}</h3>
    <p>{story.subtitle}</p>
    <div class="story-bottom">
      <span>{story.tags.slice(0, 2).join(' · ')}</span>
      <span>Open ↗</span>
    </div>
  </div>
</a>
